# The runtime uses gcloud's configured project and existing application-default credentials.
# No Gemini API key is required. The CLI intentionally ignores project .env files.
# Export this optional override in the launching shell if a different configured project is needed.
# GOOGLE_CLOUD_PROJECT=

# Optional LangSmith instrumentation. Export these in the launching shell to enable it.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=oak-local

# Model ID, location, token limits, prices, and the $40 budget are in config/runtime.json.
