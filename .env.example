# Runtime credentials, supplied locally when real model runs are configured.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LangSmith cloud tracing is enabled explicitly after account configuration.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=oak-local

# Read by the planned runtime, never interpreted as a mock provider fallback.
# Model IDs, endpoints, token limits, and spending bounds belong in versioned run config.
