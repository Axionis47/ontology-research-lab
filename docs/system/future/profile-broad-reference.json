{
  "profile_version": "1.0.0",
  "status": "proposed-not-installed",
  "model_transport": "configured-cli",
  "model_override": null,
  "token_accounting_mode": "observed",
  "strict_mode_requires_complete_provider_bounds": true,
  "actor_instances_per_episode": 1,
  "concurrent_environment_operations": 1,
  "episode": {
    "max_steps": 100,
    "max_tool_attempts": 200,
    "max_model_attempts": 240,
    "deadline_seconds": 3600,
    "finalization_tool_reserve": 20,
    "finalization_time_reserve_seconds": 120,
    "max_model_attempts_per_step": 2,
    "max_tool_attempts_per_operation": 3,
    "loop_warning_repetitions": 3,
    "recovery_context_after_no_progress_steps": 8,
    "max_async_polls": 10,
    "poll_delays_seconds": [
      1,
      2,
      4,
      8,
      10
    ],
    "max_context_evidence_reads_per_step": 4
  },
  "model": {
    "timeout_seconds": 180,
    "max_adapter_input_tokens": 6144,
    "context_headroom_tokens": 512,
    "actor_output_tokens": 512,
    "judge_output_tokens": 1536,
    "repair_output_tokens": 2048,
    "max_request_bytes": 65536,
    "max_response_bytes": 262144
  },
  "context": {
    "max_recent_steps": 4,
    "max_evidence_cards": 12,
    "max_excerpt_tokens": 256,
    "max_search_results": 20,
    "max_graph_hops": 3,
    "max_graph_entities_per_operation": 1000,
    "max_graph_edges_per_operation": 5000,
    "max_artifact_page_bytes": 16384,
    "text_chunk_tokens": 1024,
    "text_chunk_overlap_tokens": 64,
    "compaction_step_interval": 20,
    "model_narrative_compaction_enabled": false,
    "decimal_mean_precision": 28,
    "max_extracted_slots": 16
  },
  "worker": {
    "memory_mib": 512,
    "cpu_seconds_per_function": 10,
    "wall_seconds_per_function": 300,
    "max_processes": 32,
    "tmpfs_mib": 64,
    "max_rpc_bytes": 65536,
    "default_tool_timeout_seconds": 30
  },
  "judge": {
    "segment_steps": 20,
    "segment_overlap_steps": 2,
    "max_segments_per_episode": 6,
    "max_expansion_requests_per_episode": 12,
    "max_model_calls_per_episode": 24,
    "max_findings_per_segment": 2,
    "max_findings_final": 8,
    "max_parent_expansion_depth": 3,
    "max_initial_causal_events": 200,
    "calibration_cases": 40,
    "minimum_supported_finding_precision": 0.9,
    "maximum_unresolved_or_abstained_fraction": 0.25,
    "successful_episode_sample_fraction": 0.1
  },
  "repair": {
    "max_candidates_per_cycle": 3,
    "max_patch_files": 3,
    "max_patch_bytes": 32768,
    "max_model_calls_per_candidate": 8,
    "max_build_seconds": 300,
    "max_cycles_without_promoted_gain": 2,
    "max_research_cycles": 10
  },
  "evaluation": {
    "pilot_train_tasks": 20,
    "pilot_dev_tasks": 10,
    "rollouts_per_task": 3,
    "promotion_max_candidates": 30,
    "family_bootstrap_resamples": 10000,
    "familywise_alpha": 0.05,
    "promotion_noninferiority_margin": 0.0,
    "maximum_resource_ratio": 1.2,
    "control_violations_allowed": 0,
    "missing_scheduled_results_allowed": 0,
    "minimum_gate_families_per_surface": 10,
    "resource_policy": "STEP_TOOL_WALL",
    "model_warmup_policy": "one identical unscored readiness invocation per comparison batch, charged to experiment setup"
  }
}
