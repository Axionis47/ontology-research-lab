{
  "protocol_version": "1.1.0",
  "status": "SPECIFICATION_NOT_RUNTIME",
  "wire_schema": "contracts.schema.json",
  "profile": "profile.json",
  "objects": {
    "domain_structure": {"symbol": "D_v", "owner": "builder_and_release_controller", "contents": ["schema", "source_mappings", "relational_constraint_procedures", "function_interfaces"], "update": "validated_candidate_between_episodes"},
    "observed_data": {"symbol": "G_e,r", "owner": "trusted_ingestion", "contents": ["entities", "property_values", "relationships", "provenance", "validity"], "update": "admitted_observation_or_checked_derivation"},
    "task_contract": {"symbol": "T_e,Q_e", "owner": "trusted_task_adapter", "contents": ["goal", "bindings", "required_predicates", "preferences", "scope"], "update": "explicit_authorized_task_binding"},
    "constraint_workspace": {"symbol": "H_e,t", "owner": "checked_computation", "contents": ["candidate_sets", "dependency_edges", "predicate_results", "evidence_gaps"], "update": "recompute_against_pinned_task_and_current_data"},
    "control_state": {"symbol": "X_e,t", "owner": "scheduler_ledger_reducer", "contents": ["lifecycle", "revision", "manifest", "budgets", "pending_effects", "requirements"], "update": "guarded_compare_and_set_transition"},
    "experience_archive": {"symbol": "A", "owner": "trusted_ledger_writer", "contents": ["traces", "evaluations", "candidate_lineage", "rejections"], "update": "append_only"}
  },
  "record_roles": {
    "task_binding": "TaskSpec",
    "requirement_definition": "Requirement",
    "checked_predicate": "CheckedFact",
    "episode_binding": "EpisodeManifest",
    "actor_output": "Proposal",
    "callable_binding": "OperationContract",
    "admission": "AdmissionDecision",
    "dispatch": "DispatchIntent",
    "result": "OperationReceipt",
    "actor_observation": "Observation",
    "source_evidence": "EvidenceRef",
    "fact_update": "GraphDelta",
    "control_transition": "LifecycleTransition",
    "repair_target": "RepairSpec",
    "candidate": "CandidateManifest",
    "release_decision": "GateDecision"
  },
  "constraints": {
    "protected_policy": {"solver_may_modify": false},
    "task_obligations": {"solver_may_modify": false, "values_may_differ_between_tasks": true},
    "domain_representation": {"solver_may_modify": false, "offline_repair_requires_independent_semantic_evidence": true},
    "handling_procedures": {"offline_candidate_editable": true},
    "truth_values": ["TRUE", "FALSE", "UNKNOWN"],
    "unknown_satisfies_required_predicate": false,
    "preferences_may_override_required_predicates": false,
    "partial_search_proves_global_infeasibility": false
  },
  "knowledge_access": {
    "transport": "existing_manifest_bound_act",
    "stages": ["BIND", "EXPOSE_INTERFACE", "PROPOSE", "ADMIT", "COMPUTE", "VALIDATE_RESULT", "OBSERVE"],
    "scope_owner": "authenticated_runtime",
    "actor_may_write_facts_directly": false,
    "actor_may_edit_package": false,
    "candidate_may_contain_task_answer_tables": false,
    "model_receives": ["public_goal_and_constraints", "selected_tool_contracts", "bounded_results_and_evidence"],
    "new_generic_operators": []
  },
  "control": {
    "owner": "trusted_scheduler",
    "initial_state": "CREATED",
    "terminal_state": "TERMINAL",
    "global_guards": ["producer_authenticated", "event_schema_valid", "expected_revision_current", "edge_allowed", "durable_transition_commit"],
    "allowed_next": {
      "CREATED": ["PREPARING", "TERMINAL"],
      "PREPARING": ["READY", "SUSPENDED", "TERMINAL"],
      "READY": ["INFERENCING", "VERIFYING", "SUSPENDED", "TERMINAL"],
      "INFERENCING": ["ADMITTING", "READY", "SUSPENDED", "TERMINAL"],
      "ADMITTING": ["EXECUTING", "READY", "VERIFYING", "WAITING_INPUT", "SUSPENDED", "TERMINAL"],
      "EXECUTING": ["READY", "RECONCILING", "SUSPENDED", "TERMINAL"],
      "RECONCILING": ["READY", "SUSPENDED", "TERMINAL"],
      "VERIFYING": ["READY", "EVALUATING", "SUSPENDED", "TERMINAL"],
      "WAITING_INPUT": ["READY", "SUSPENDED", "TERMINAL"],
      "EVALUATING": ["TERMINAL"],
      "SUSPENDED": ["PREPARING", "RECONCILING", "TERMINAL"],
      "TERMINAL": []
    },
    "entry_guards": {
      "CREATED": [],
      "PREPARING": ["scheduled_identity_preserved"],
      "READY": ["manifest_bindings_valid", "no_unresolved_effect", "continuation_receipts_valid"],
      "INFERENCING": ["context_valid_and_committed", "model_budget_reserved"],
      "ADMITTING": ["one_valid_proposal"],
      "EXECUTING": ["allowed_admission_current", "dispatch_intent_committed"],
      "RECONCILING": ["pending_effect_identified", "actor_mutations_disabled"],
      "VERIFYING": ["completion_or_finalization_trigger"],
      "WAITING_INPUT": ["interactive_input_supported", "checkpoint_and_question_committed"],
      "EVALUATING": ["acting_stopped_terminal_state_fixed", "verification_routing_valid"],
      "SUSPENDED": ["cause_and_outstanding_effects_recorded"],
      "TERMINAL": ["terminal_axes_and_unresolved_effects_recorded"]
    },
    "proposal_routing": {
      "act": {"accepted_state": "EXECUTING", "rejected_state": "READY"},
      "revisit": {"accepted_state": "READY", "rejected_state": "READY"},
      "finish": {"accepted_state": "VERIFYING", "rejected_state": "READY"},
      "request_input": {"accepted_state": "WAITING_INPUT", "rejected_state": "READY"}
    },
    "guard_catalog": {
      "producer_authenticated": "Resolve event authority from the trusted producer binding, never a model-supplied role.",
      "event_schema_valid": "Validate closed event schema and referenced records before reduction.",
      "expected_revision_current": "Compare expected lifecycle revision with durable current state.",
      "edge_allowed": "Reject any edge absent from allowed_next, including every outgoing terminal edge.",
      "durable_transition_commit": "Append event and update state projection atomically under compare-and-set.",
      "scheduled_identity_preserved": "Preserve scheduled episode identity, original allocation and any existing pinned package.",
      "manifest_bindings_valid": "Verify manifest, package, environment, policy and enabled tool identities against trusted bindings.",
      "no_unresolved_effect": "No pending or unknown external effect remains before actor continuation.",
      "continuation_receipts_valid": "The source-state-specific preparation, observation, denial, verification, input or reconciliation receipt permits continuation.",
      "context_valid_and_committed": "Current public task, interfaces and bounded observations fit; exact model input is committed.",
      "model_budget_reserved": "Model/step/time admission and reservation succeed within the original allowance.",
      "one_valid_proposal": "A completed model receipt parses as exactly one Proposal variant.",
      "allowed_admission_current": "The admitted binding and arguments passed protected checks; volatile conditions are rechecked before dispatch.",
      "dispatch_intent_committed": "A current unused admission is consumed with a durable dispatch intent before external execution.",
      "pending_effect_identified": "An authentic operation receipt or interrupted dispatch identifies pending or unknown effects.",
      "actor_mutations_disabled": "Only authorized reconciliation activity can run while effect certainty is unresolved.",
      "completion_or_finalization_trigger": "A finish proposal, native terminal signal or trusted finalization trigger requests verification.",
      "interactive_input_supported": "The task declares interactive input and the requested information is genuinely unavailable.",
      "checkpoint_and_question_committed": "Persist requested fields, checkpoint and unchanged remaining allowance before waiting.",
      "acting_stopped_terminal_state_fixed": "Stop actor dispatch and pin the actual environment state used by the privileged evaluator.",
      "verification_routing_valid": "Public checks and declared coverage justify terminal evaluation, or a native-terminal/limit path applies; hidden checks were not exposed to the actor.",
      "cause_and_outstanding_effects_recorded": "Record suspension cause and exact unresolved operations without inventing rollback.",
      "terminal_axes_and_unresolved_effects_recorded": "Commit stop reason, task/control/trace/evaluation axes and unresolved effects; terminal does not imply success."
    },
    "verified_success_requires": ["native_task_pass", "applicable_public_checks_true", "control_checks_pass", "trace_complete", "no_unresolved_effect"],
    "actor_may_assign_success": false,
    "package_change_within_episode": false,
    "unknown_write_retry": "RECONCILE_FIRST"
  },
  "learning": {
    "primary_target": "reusable_relationship_and_constraint_handling",
    "weights_trainable": false,
    "automatically_editable": ["schema", "source_mappings", "function_implementations", "function_io_contracts"],
    "editable_file_classes": ["schema.json", "mappings.json", "functions/*.py", "function_contracts/*.json"],
    "protected": ["kernel", "policy", "task_obligations", "required_checkers", "operator_membership_and_runtime", "evaluator", "ledger_instrumentation", "budgets", "sandbox", "promotion_rules"],
    "excluded_optimization_targets": ["task_instance_values", "task_answer_tables", "context_items", "workflow_suggestions"],
    "schema_default": "PRESERVE",
    "schema_change_requires": ["independent_semantic_evidence", "distinguishing_reproducer", "compatible_interfaces", "projection_rebuild_from_authorized_evidence"],
    "comparison_holds_fixed": ["actor_model_settings", "task_obligations", "available_source_data", "authority", "budgets", "reset_schedule", "evaluator"],
    "fixture_variation_axes": ["entity_identity_and_values", "relationship_topology", "constraint_combinations", "evidence_missingness_and_freshness"],
    "selection_inputs": ["FIT", "DEVELOPMENT"],
    "sealed_check_available_to_proposer": false,
    "release": "gate_then_registry_compare_and_set_for_new_episodes",
    "gate_document": "08-evaluation-and-success.md"
  },
  "consolidation": {
    "status": "SPECIFICATION_NOT_RUNTIME",
    "stages": ["PIN_CASE", "DISCOVER_EXISTING", "RESOLVE_IDENTITIES", "LOCATE_GAP", "VALIDATE_DELTA", "ARCHIVE_DECISION"],
    "discovery_targets": ["entity_instances", "entity_types", "property_definitions", "relation_definitions", "source_mappings", "function_interfaces"],
    "entity_identity": ["environment_scope", "episode_scope", "source_namespace", "entity_type", "source_key"],
    "same_display_name_proves_identity": false,
    "cooccurrence_proves_relation": false,
    "empty_page_proves_schema_absence": false,
    "partial_discovery_allows_schema_extension": false,
    "actor_may_commit_consolidation": false,
    "live_episode_package_may_change": false,
    "query_bounds": "existing_job_evidence_gateway_and_active_profile",
    "query_receipts_require": ["scope", "package_hash", "graph_revision", "query", "returned_ids", "evidence_refs", "coverage", "continuation"],
    "case_requires": ["original_goal_ref", "trigger_event_ref", "kernel_or_package_version", "pre_handoff_evidence_refs", "continuation_event_refs", "terminal_outcome_ref", "evaluation_receipt_or_explicit_unavailable"],
    "decision_requires": ["case_refs", "discovery_receipt_refs", "reused_entity_ids", "reused_definition_ids", "gap_class", "proposed_delta_or_no_change", "supporting_evidence_refs", "validation_refs", "decision_and_reason"],
    "gap_routes": {
      "OBSERVATION_GAP": {"target": "observed_data", "writer": "trusted_ingestion", "schema_change": false},
      "MAPPING_GAP": {"target": "source_mappings", "writer": "offline_candidate", "schema_change": false},
      "COMPOSITION_GAP": {"target": "function_implementations", "writer": "offline_candidate", "schema_change": false},
      "SCHEMA_GAP": {"target": "schema", "writer": "offline_candidate", "schema_change": true},
      "NEEDS_EVIDENCE": {"target": null, "writer": null, "schema_change": false},
      "CONTROL_FAILURE": {"target": null, "writer": "separate_engineering_process", "schema_change": false},
      "NO_CHANGE": {"target": null, "writer": null, "schema_change": false}
    },
    "schema_gap_requires": ["scoped_discovery_complete", "independent_semantic_evidence", "mapping_or_composition_fix_insufficient", "distinguishing_reproducer"],
    "existing_wire_records": ["EvidenceRef", "OperationReceipt", "GraphDelta", "RepairSpec", "CandidateManifest", "GateDecision"],
    "new_generic_operators": []
  },
  "profile_bindings": {
    "max_steps": "/episode/max_steps",
    "max_tool_attempts": "/episode/max_tool_attempts",
