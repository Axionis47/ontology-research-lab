{
  "version": "approval-ontology-v1",
  "definitions": {
    "Person": {
      "kind": "type",
      "meaning": "An identified human."
    },
    "Service": {
      "kind": "type",
      "meaning": "A software service."
    },
    "Assignment": {
      "kind": "type",
      "meaning": "An observed role of a person for a service, with environment and validity interval.",
      "properties": [
        "id",
        "person",
        "service",
        "environment",
        "role",
        "validFrom",
        "validUntil",
        "active"
      ],
      "requires": [
        "Person",
        "Service",
        "heldBy",
        "forService"
      ]
    },
    "Deployment": {
      "kind": "type",
      "meaning": "A proposed deployment of a service, with an author.",
      "properties": [
        "id",
        "service",
        "author"
      ],
      "requires": [
        "Person",
        "Service"
      ]
    },
    "heldBy": {
      "kind": "relation",
      "meaning": "Assignment.person identifies the person holding this assignment; it is not the deployment author."
    },
    "forService": {
      "kind": "relation",
      "meaning": "Assignment.service identifies the service to which that assignment applies."
    },
    "eligibility": {
      "kind": "rule_set",
      "meaning": "All six rules must hold. Missing evidence is UNKNOWN and never establishes eligibility.",
      "rules": [
        {
          "id": "R1",
          "meaning": "Assignment service must equal task service."
        },
        {
          "id": "R2",
          "meaning": "Assignment environment must equal task environment."
        },
        {
          "id": "R3",
          "meaning": "Assignment role must be DeploymentApprover."
        },
        {
          "id": "R4",
          "meaning": "Assignment active must be true."
        },
        {
          "id": "R5",
          "meaning": "Assignment validFrom <= task at < assignment validUntil; the end is exclusive. All dates here use YYYY-MM-DD."
        },
        {
          "id": "R6",
          "meaning": "Assignment person must differ from the deployment author."
        }
      ],
      "requires": [
        "Assignment",
        "Deployment"
      ]
    },
    "Invoice": {
      "kind": "type",
      "meaning": "A billing record."
    },
    "Warehouse": {
      "kind": "type",
      "meaning": "A storage location."
    },
    "Shipment": {
      "kind": "type",
      "meaning": "A movement of goods."
    },
    "Subscription": {
      "kind": "type",
      "meaning": "A recurring service agreement."
    },
    "Asset": {
      "kind": "type",
      "meaning": "An item tracked for accounting."
    },
    "PurchaseOrder": {
      "kind": "type",
      "meaning": "A request to purchase goods."
    },
    "Payment": {
      "kind": "type",
      "meaning": "A transfer to settle an obligation."
    },
    "Refund": {
      "kind": "type",
      "meaning": "A reversal of a payment."
    },
    "TaxRate": {
      "kind": "type",
      "meaning": "A jurisdiction-specific rate."
    },
    "Expense": {
      "kind": "type",
      "meaning": "A recorded cost."
    },
    "Supplier": {
      "kind": "type",
      "meaning": "An organization providing goods."
    },
    "Inventory": {
      "kind": "type",
      "meaning": "A quantity of stocked goods."
    }
  }
}
